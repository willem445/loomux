node_modules/
dist/
# Cargo build output. At the WORKSPACE ROOT since #888 slice A1 — cargo keeps
# one `target/` per workspace, next to the root manifest, not one per member.
# Left unanchored so a member built in isolation is covered too.
target/
src-tauri/gen/schemas/
*.log
test-results/
playwright-report/
.claude/worktrees/
.claude/settings.local.json

# Per-agent scratch space (#625): PR bodies, review drafts, anything an agent would
# otherwise have written to the machine-wide /tmp, where two agents picking the same
# obvious filename silently overwrite each other. Worktree-local and disposable.
.scratch/

# The workflow pane's canvas positions (#222): where the boxes sit, never what the
# workflow IS. Disposable and per-developer — the workflow itself (.orrerix/workflow.yml)
# is committed, this is not.
.orrerix/workflow.layout.json
.scratch/
